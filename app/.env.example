# Estes são exemplos e endereços locais, nunca credenciais reais.
# Copie este arquivo para .env.local e preencha com suas chaves reais.

# URL do Supabase (ex: http://127.0.0.1:54321 ou seu projeto gerenciado)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anônima/publica do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Chave de serviço do Supabase (mantenha em sigilo)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Chaves da API do Stripe (opcional, para pagamentos por cartão)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Chave da API Resend (opcional, para envio de e-mails de faturas)
RESEND_API_KEY=
