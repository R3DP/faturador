# Estes são marcadores e endereços locais, nunca credenciais reais.
# Valores visíveis no navegador são incorporados durante a compilação. Recompile após alterá-los.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-own-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-own-service-role-key
# URL opcional entre servidores quando o app é executado no Docker.
# Deve alcançar o MESMO banco de dados que NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_INTERNAL_URL=
# O cadastro fecha após a primeira conta, que será a proprietária deste Faturador. Defina como true para
# permitir que mais pessoas se cadastrem (por exemplo, para adicionar alguém à equipe) e depois remova a configuração.
BILLR_OPEN_SIGNUP=
# Pagamentos opcionais com cartão, na sua própria conta Stripe. Defina as três variáveis ou nenhuma.
# O endpoint do webhook é <NEXT_PUBLIC_APP_URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Envio opcional de faturas por e-mail: use sua própria chave do Resend e um domínio de remetente verificado.
RESEND_API_KEY=
RESEND_INVOICE_FROM=
# Limite opcional de e-mails enviados: envios por empresa a cada 24 horas. Sem limite se não for definido.
BILLR_EMAIL_DAILY_LIMIT=
# Opcional. Informe o cabeçalho de valor único que SEU proxy reverso SOBRESCREVE com o
# endereço real do cliente (comumente X-Real-IP). Deixe vazio quando o proxy acrescentar
# valores a X-Forwarded-For; o Faturador usa o último item dessa lista. Nunca informe um
# cabeçalho que o proxy apenas encaminha: os limites de requisições usam este valor como chave.
BILLR_TRUSTED_IP_HEADER=
