# Consulte https://help.github.com/articles/ignoring-files/ para saber mais sobre arquivos ignorados.

# dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testes
/coverage

# next.js
/.next/
/out/

# produção
/build

# diversos
.DS_Store
*.pem

# depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# arquivos de ambiente (podem ser incluídos no commit se necessário)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Estado e chaves da instalação local auto-hospedada
.self-host/
.env.local

# Criado pelo next dev quando executado por um agente de programação
/AGENTS.md
/CLAUDE.md
